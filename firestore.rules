rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write their own profile document (stores customPhotoURL, etc.)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Each user can only read and write their own runs.
    match /users/{uid}/runs/{runId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Each user can only read and write their own planned routes.
    match /users/{uid}/routes/{routeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Each user can read and write their own training plan.
    match /users/{uid}/plan/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
