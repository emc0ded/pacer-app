# ─────────────────────────────────────────────────────────────
# Pacer — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Mapbox GL JS
# Get your token → https://account.mapbox.com/
VITE_MAPBOX_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN_HERE

# ── Firebase ──────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdefabcdef

# ── Anthropic (AI features — Week 4+) ─────────────────────────
# Get your key → https://console.anthropic.com/
# ⚠️  WARNING: For production, proxy this through a backend function
#    (e.g. Firebase Cloud Function) — never expose your key in a public PWA.
VITE_ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
